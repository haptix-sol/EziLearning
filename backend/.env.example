# Database — PostgreSQL (see comments in generated .env)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# If PASSWORD contains @ or #, URL-encode: @ → %40, # → %23
# Create DB: CREATE DATABASE ezilearning;
DATABASE_URL=postgresql://postgres:changeme@localhost:5433/ezilearning

# Optional
# REDIS_URL=redis://localhost:6379/0

# LLM: OpenAI (recommended) or Cursor
# OpenAI - works out of the box: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_MODEL=gpt-4o-mini

# Local Cursor proxy: cd cursor2api && npm install && npm run dev — see docs/EZILEARNING_CURSOR_PROXY_SETUP.md
# Set CURSOR_API_URL when the proxy is running. CURSOR_API_KEY can be any value if auth_tokens is unset.
# CURSOR_API_URL=http://localhost:3010/v1
# CURSOR_API_KEY=ezilearning-local
# CURSOR_API_MODEL=kimi-k2.5
# LLM_TIMEOUT=120

# Storage
RESUME_STORAGE_PATH=./data/resumes

# Varin (Rust) — video generation. Build: cd Varin && cargo build --release
# VARIN_CLI_PATH=./Varin/target/release/varin.exe
# VARIN_RUST_ROOT=./Varin
# Optional: override intermediate render dir (default <Varin rust root>/render)
# VARIN_RENDER_WORK_PATH=

# FFmpeg — repo-local install (sibling folder: ../ffmpeg/bin/). See ../ffmpeg/README.md
# Windows:
FFMPEG_PATH=../ffmpeg/bin/ffmpeg.exe
# Linux/macOS (uncomment if you use a local tree without .exe):
# FFMPEG_PATH=../ffmpeg/bin/ffmpeg
# Optional: only if ffprobe is not beside ffmpeg
# FFPROBE_PATH=../ffmpeg/bin/ffprobe.exe

# Gmail OAuth - https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web app), add http://localhost:8000/gmail/callback to redirect URIs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback

# Required for job portal credential encryption. Without it, storing passwords will fail.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-32-char-secret-key-here
