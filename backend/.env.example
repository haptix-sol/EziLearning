# Database — PostgreSQL (see comments in generated .env)
# Option A — single URL (password must NOT contain raw @ or the host will parse wrong, e.g. "27@localhost"):
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# If PASSWORD contains @ or #, URL-encode: @ → %40, # → %23
#
# Option B — split vars (recommended if the password has @, #, :, etc.):
#   POSTGRES_HOST=localhost
#   POSTGRES_PORT=5433
#   POSTGRES_USER=postgres
#   POSTGRES_PASSWORD=your_password
#   POSTGRES_DB=ezilearning
# When POSTGRES_HOST is set, it overrides DATABASE_URL for the connection string.
#
# Create DB: CREATE DATABASE ezilearning;
DATABASE_URL=postgresql://postgres:changeme@localhost:5433/ezilearning

# Optional
# REDIS_URL=redis://localhost:6379/0

# LLM (pick one; LLM_PROVIDER=auto prefers Bedrock when model + AWS creds exist, else OpenAI, else compatible URL)
# LLM_PROVIDER=auto
# LLM_TIMEOUT=120

# Amazon Bedrock (Converse API) — Qwen (recommended for this app)
# Put real keys only in backend/.env (never commit). Use ap-south-1 or the region where your model is enabled.
# BEDROCK_REGION=ap-south-1
# AWS_DEFAULT_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Bedrock Runtime Converse — use the exact Model ID from the console (Model catalog / Playground) for your region.
# Example (Qwen3 32B, Converse-supported): qwen.qwen3-32b-v1:0
# Do not guess legacy IDs (e.g. qwen.qwen2.5-72b-instruct-v0:1); wrong IDs yield ValidationException: invalid model identifier.
# Inference profile / full ARN also works if shown in console.
# BEDROCK_MODEL_ID=qwen.qwen3-32b-v1:0
# LLM_PROVIDER=bedrock

# OpenAI official API (optional fallback or LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_API_MODEL=gpt-4o-mini

# OpenAI-compatible HTTP only for local dev (not for production LLM)
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:3010/v1
# OPENAI_COMPATIBLE_API_KEY=any
# OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# Deprecated env names (still read if OPENAI_COMPATIBLE_* unset):
# CURSOR_API_URL=http://localhost:3010/v1
# CURSOR_API_KEY=local
# CURSOR_API_MODEL=kimi-k2.5

# Storage
RESUME_STORAGE_PATH=./data/resumes
# DEBUG=false

# FFmpeg — repo-local install (sibling folder: ../ffmpeg/bin/). See ../ffmpeg/README.md
# Windows:
FFMPEG_PATH=../ffmpeg/bin/ffmpeg.exe
# Linux/macOS (uncomment if you use a local tree without .exe):
# FFMPEG_PATH=../ffmpeg/bin/ffmpeg
# Optional: only if ffprobe is not beside ffmpeg
# FFPROBE_PATH=../ffmpeg/bin/ffprobe.exe

# Gmail OAuth - https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web app), add http://localhost:8000/gmail/callback to redirect URIs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback

# Required for job portal credential encryption. Without it, storing passwords will fail.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-32-char-secret-key-here
